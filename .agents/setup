#!/usr/bin/env bash
# Prepares an orb for robertguss/mo: C compilers with sanitizers and libFuzzer,
# clang-format and clang-tidy, make, Bison for the executable grammar, and
# Lean 4, through elan, for Mo Core. Installs only; never builds or runs anything.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

install_missing() {
	local missing=() package
	for package in "$@"; do
		if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
			missing+=("$package")
		fi
	done
	if ((${#missing[@]})); then
		sudo apt-get update -qq
		sudo apt-get install -y -qq "${missing[@]}"
	fi
}

install_missing build-essential clang clang-format clang-tidy make git bison

# libFuzzer and the sanitizer runtimes ship in a package named after clang's
# major version.
clang_major=$(clang --version | sed -n 's/.*clang version \([0-9][0-9]*\).*/\1/p' | head -n 1)
install_missing "libclang-rt-${clang_major}-dev"

# Lean 4 for Mo Core (formal/), through elan with no default toolchain: the
# version formal/lean-toolchain names is installed, and lake uses it.
if [[ ! -x "$HOME/.elan/bin/elan" ]]; then
	curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh |
		sh -s -- -y --no-modify-path --default-toolchain none
fi
"$HOME/.elan/bin/elan" toolchain install "$(cat "$(dirname "${BASH_SOURCE[0]}")/../formal/lean-toolchain")"

printf 'robertguss/mo orb ready: %s, %s, %s\n' "$(gcc --version | head -n 1)" "$(clang --version | head -n 1)" \
	"$("$HOME/.elan/bin/elan" --version)"
