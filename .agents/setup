#!/usr/bin/env bash
# Prepares an orb for robertguss/mo: C compilers with sanitizers and libFuzzer,
# clang-format and clang-tidy, make, and Bison for the executable grammar.
# Installs only; never builds or runs anything.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

install_missing() {
	local missing=() package
	for package in "$@"; do
		if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
			missing+=("$package")
		fi
	done
	if ((${#missing[@]})); then
		sudo apt-get update -qq
		sudo apt-get install -y -qq "${missing[@]}"
	fi
}

install_missing build-essential clang clang-format clang-tidy make git bison

# libFuzzer and the sanitizer runtimes ship in a package named after clang's
# major version.
clang_major=$(clang --version | sed -n 's/.*clang version \([0-9][0-9]*\).*/\1/p' | head -n 1)
install_missing "libclang-rt-${clang_major}-dev"

printf 'robertguss/mo orb ready: %s, %s\n' "$(gcc --version | head -n 1)" "$(clang --version | head -n 1)"
