#!/usr/bin/env bash
# Prepares an orb for robertguss/mo: C compilers with sanitizers and libFuzzer,
# clang-format and clang-tidy, make, Bison for the executable grammar, CBMC for
# the bytecode reader, arena, verifier, primitives, path containment and
# resolution, refcounts, hash tables (cbmc/), and
# Lean 4, through elan, for Mo Core. Installs only; never builds or runs anything.
#
#   bash .agents/setup            everything
#   bash .agents/setup GROUP...   only what those ci/check.sh groups need
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

groups=" $* "
needs() { [[ "$groups" == "  " || "$groups" == *" $1 "* ]]; }

install_missing() {
	local missing=() package
	for package in "$@"; do
		if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
			missing+=("$package")
		fi
	done
	if ((${#missing[@]})); then
		sudo apt-get update -qq
		sudo apt-get install -y -qq "${missing[@]}"
	fi
}

packages=(build-essential clang make git python3)
if needs static; then packages+=(clang-format-14 clang-tidy-18 bison); fi
if needs cbmc; then packages+=(cbmc); fi
install_missing "${packages[@]}"

if needs static; then
	sudo mkdir -p /usr/local/bin
	sudo ln -sfn /usr/bin/clang-format-14 /usr/local/bin/clang-format
	sudo ln -sfn /usr/bin/clang-tidy-18 /usr/local/bin/clang-tidy
	PATH="/usr/local/bin:$PATH" clang-format --version | grep -F 'version 14.0.6'
fi

# libFuzzer and the sanitizer runtimes ship in a package named after clang's
# major version. lean needs them too: run alone it builds the sanitize executables it compares.
# -fsanitize=fuzzer also needs libstdc++ for the GCC install clang selects (often newer
# than the one build-essential pulled in).
if needs sanitize || needs fuzz || needs lean || needs static; then
	clang_major=$(clang --version | sed -n 's/.*clang version \([0-9][0-9]*\).*/\1/p' | head -n 1)
	rt_packages=("libclang-rt-${clang_major}-dev")
	if needs fuzz; then
		gcc_major=$(clang -v 2>&1 | sed -n 's|^Selected GCC installation: .*/\([0-9][0-9]*\)$|\1|p' | head -n 1)
		if [[ -z "$gcc_major" ]]; then
			echo "error: could not read Selected GCC installation from clang -v" >&2
			exit 1
		fi
		rt_packages+=("libstdc++-${gcc_major}-dev")
	fi
	install_missing "${rt_packages[@]}"
fi

# Same link probe as ci/check.sh has_libfuzzer: setup must leave fuzz runnable.
if needs fuzz; then
	probe_dir=$(mktemp -d)
	printf 'int LLVMFuzzerTestOneInput(const unsigned char *d, unsigned long n);\nint LLVMFuzzerTestOneInput(const unsigned char *d, unsigned long n) { (void)d; (void)n; return 0; }\n' >"$probe_dir/probe.c"
	if ! clang -fsanitize=fuzzer "$probe_dir/probe.c" -o "$probe_dir/probe"; then
		rm -rf "$probe_dir"
		echo "error: clang -fsanitize=fuzzer still fails after installing libclang-rt and libstdc++" >&2
		exit 1
	fi
	rm -rf "$probe_dir"
fi

# Lean 4 for Mo Core (formal/), through elan with no default toolchain, in
# /opt/elan rather than in HOME: the CI orb runs the checks with a fresh, empty
# HOME. The version formal/lean-toolchain names is installed, and lake uses it.
if needs lean; then
	export ELAN_HOME=/opt/elan
	if [[ ! -x "$ELAN_HOME/bin/elan" ]]; then
		sudo mkdir -p "$ELAN_HOME"
		sudo chown "$(id -u):$(id -g)" "$ELAN_HOME"
		curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh |
			sh -s -- -y --no-modify-path --default-toolchain none
	fi
	"$ELAN_HOME/bin/elan" toolchain install "$(cat "$(dirname "${BASH_SOURCE[0]}")/../formal/lean-toolchain")"
fi

printf 'robertguss/mo orb ready for %s: %s, %s\n' "${*:-every group}" "$(gcc --version | head -n 1)" \
	"$(clang --version | head -n 1)"
