#!/usr/bin/env bash
# Prepares an orb for robertguss/mo: C compilers with sanitizers and libFuzzer,
# clang-format and clang-tidy, make, Bison for the executable grammar, CBMC for
# the bytecode reader's proofs (cbmc/), and
# Lean 4, through elan, for Mo Core. Installs only; never builds or runs anything.
#
#   bash .agents/setup            everything
#   bash .agents/setup GROUP...   only what those ci/check.sh groups need, so a CI job for the
#                                 fast groups installs nothing it will not use
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

groups=" $* "
needs() { [[ "$groups" == "  " || "$groups" == *" $1 "* ]]; }

install_missing() {
	local missing=() package
	for package in "$@"; do
		if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
			missing+=("$package")
		fi
	done
	if ((${#missing[@]})); then
		sudo apt-get update -qq
		sudo apt-get install -y -qq "${missing[@]}"
	fi
}

packages=(build-essential clang make git)
if needs static; then packages+=(clang-format clang-tidy bison jq); fi
if needs cbmc; then packages+=(cbmc); fi
install_missing "${packages[@]}"

# libFuzzer and the sanitizer runtimes ship in a package named after clang's
# major version. lean needs them too: run alone it builds the sanitize executables it compares.
if needs sanitize || needs fuzz || needs lean; then
	clang_major=$(clang --version | sed -n 's/.*clang version \([0-9][0-9]*\).*/\1/p' | head -n 1)
	install_missing "libclang-rt-${clang_major}-dev"
fi

# Lean 4 for Mo Core (formal/), through elan with no default toolchain, in
# /opt/elan rather than in HOME: the CI orb runs the checks with a fresh, empty
# HOME. The version formal/lean-toolchain names is installed, and lake uses it.
if needs lean; then
	export ELAN_HOME=/opt/elan
	if [[ ! -x "$ELAN_HOME/bin/elan" ]]; then
		sudo mkdir -p "$ELAN_HOME"
		sudo chown "$(id -u):$(id -g)" "$ELAN_HOME"
		curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh |
			sh -s -- -y --no-modify-path --default-toolchain none
	fi
	"$ELAN_HOME/bin/elan" toolchain install "$(cat "$(dirname "${BASH_SOURCE[0]}")/../formal/lean-toolchain")"
fi

printf 'robertguss/mo orb ready for %s: %s, %s\n' "${*:-every group}" "$(gcc --version | head -n 1)" \
	"$(clang --version | head -n 1)"
