PRIM(INT_FLOOR_DIV,             "Int",       "floor_div",          "fn(Int, Int) : Int",                         "bb",  "dividing by zero; overflow")
PRIM(INT_FLOOR_MOD,             "Int",       "floor_mod",          "fn(Int, Int) : Int",                         "bb",  "dividing by zero")
PRIM(INT_WRAPPING_ADD,          "Int",       "wrapping_add",       "fn(Int, Int) : Int",                         "bb",  "")
PRIM(INT_WRAPPING_SUB,          "Int",       "wrapping_sub",       "fn(Int, Int) : Int",                         "bb",  "")
PRIM(INT_WRAPPING_MUL,          "Int",       "wrapping_mul",       "fn(Int, Int) : Int",                         "bb",  "")
