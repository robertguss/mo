+static MO_MUST_USE enum mo_host_outcome prototype_connection(struct mo_host *host,
+                                                            struct mo_heap *heap,
+                                                            uint32_t operation, uint32_t type,
+                                                            const struct mo_cell *args,
+                                                            struct mo_cell *out) {
+    struct mo_file_error problem = {.status = FILE_OK};
+    struct mo_cell value = mo_cell_unit();
+    bool made = false;
+    if (prototype_socket < 0) {
+        size_t length;
+        const uint8_t *target = mo_value_data(args[1], &length);
+        unsigned port = 0;
+        for (size_t i = 4; i < length; i++)
+            port = port * 10 + (unsigned)(target[i] - '0');
+        struct sockaddr_in address;
+        memset(&address, 0, sizeof address);
+        address.sin_family = AF_INET;
+        address.sin_port = htons((uint16_t)port);
+        address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        prototype_socket = socket(AF_INET, SOCK_STREAM, 0);
+        if (prototype_socket < 0 ||
+            connect(prototype_socket, (const struct sockaddr *)&address, sizeof address) != 0)
+            problem = mo_host_errno(errno);
+    }
+    if (problem.status == FILE_OK && operation == MO_HOST_FILES_WRITE_TEXT)
+        problem = write_file(prototype_socket, args[2], true);
+    else if (problem.status == FILE_OK) {
+        static uint8_t buffer[65536];
+        ssize_t n;
+        do {
+            n = read(prototype_socket, buffer, sizeof buffer);
+        } while (n < 0 && errno == EINTR);
+        if (n < 0)
+            problem = mo_host_errno(errno);
+        else {
+            if (n == 0) {
+                (void)close(prototype_socket);
+                prototype_socket = -1;
+            }
+            if (!mo_value_bytes(heap, buffer, (size_t)n, &value))
+                return MO_HOST_OUT_OF_MEMORY;
+            made = true;
+        }
+    }
+    if (problem.status != FILE_OK)
+        return mo_host_file_error(host, heap, type, args[1], problem, out);
+    enum mo_host_outcome outcome = mo_host_file_ok(host, heap, type, value, out);
+    if (made) {
+        uint32_t payload =
+            host->types->types.items[type].cases[mo_host_tag(host, type, "Ok")].fields[0].type;
+        mo_value_drop(heap, payload, value);
+    }
+    return outcome;
+}
