+static MO_MUST_USE enum mo_prim_status prototype_bytes(struct mo_prim_call *c,
+                                                       struct mo_cell *out) {
+    if (c->id == MO_PRIM_BYTES_SLICE) {
+        struct text bytes = view(c->args[0]);
+        int64_t size = (int64_t)bytes.length;
+        int64_t start = mo_cell_get_int(c->args[1]), end = mo_cell_get_int(c->args[2]);
+        start = start < 0 ? 0 : start > size ? size : start;
+        end = end < start ? start : end > size ? size : end;
+        const uint8_t *from = start == end ? (const uint8_t *)"" : bytes.bytes + start;
+        return mo_value_bytes(c->heap, from, (size_t)(end - start), out) ? MO_PRIM_RETURNED
+                                                                         : MO_PRIM_OUT_OF_MEMORY;
+    }
+    uint32_t count = mo_list_size(c->args[0]);
+    size_t length = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        struct mo_cell part;
+        MO_ASSERT(mo_list_get(c->args[0], i, &part));
+        length += view(part).length;
+        if (!mo_prim_bytes_fit(c, length))
+            return MO_PRIM_OUT_OF_MEMORY;
+    }
+    if (length == 0)
+        return mo_value_bytes(c->heap, (const uint8_t *)"", 0, out) ? MO_PRIM_RETURNED
+                                                                    : MO_PRIM_OUT_OF_MEMORY;
+    struct mo_scratch scratch;
+    mo_scratch_init(&scratch, c->heap);
+    uint8_t *joined = mo_scratch_resize(&scratch, NULL, 0, length);
+    enum mo_prim_status status = MO_PRIM_OUT_OF_MEMORY;
+    if (joined != NULL) {
+        size_t at = 0;
+        for (uint32_t i = 0; i < count; i++) {
+            struct mo_cell part;
+            MO_ASSERT(mo_list_get(c->args[0], i, &part));
+            struct text piece = view(part);
+            if (piece.length != 0)
+                memcpy(joined + at, piece.bytes, piece.length);
+            at += piece.length;
+        }
+        if (mo_value_bytes(c->heap, joined, length, out))
+            status = MO_PRIM_RETURNED;
+    }
+    mo_scratch_free(&scratch);
+    return status;
+}
