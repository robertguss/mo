+
+/* What each step of a failing sequence's last run replied, copied into the checker's heap, and the
+ * service module's guarantee_ functions. */
 struct replies {
     struct mo_recovery *recovery;
+    const struct mo_bytecode *file;
+    const struct mo_bytecode_service *service;
+    struct guarantee guarantees[GUARANTEES];
+    uint32_t guarantee_count;
     struct mo_cell values[MO_CLI_RECOVERY_STEPS];
     uint32_t types[MO_CLI_RECOVERY_STEPS];
 };
 
+static bool same_types(const struct mo_parameter *parameters, const uint32_t *types,
+                       uint32_t count) {
+    for (uint32_t i = 0; i < count; i++)
+        if (parameters[i].type != types[i])
+            return false;
+    return true;
+}
+
+/* (before: State, after: State) holds at every step; (before: State, a tool's arguments, its
+ * result, after: State) at each of that tool's replies. */
+static void find_guarantees(struct replies *w) {
+    static const char prefix[] = ".guarantee_";
+    const struct mo_bytecode *file = w->file;
+    const struct mo_bytecode_service *service = w->service;
+    const struct mo_bytecode_string *module = &file->strings[file->modules[service->module].name];
+    for (uint32_t f = 0; f < file->function_count; f++) {
+        const struct mo_bytecode_function *function = &file->functions[f];
+        const struct mo_bytecode_string *name = &file->strings[function->name];
+        if (function->kind != MO_FUNCTION_FUNCTION ||
+            name->length <= module->length + sizeof prefix - 1 ||
+            memcmp(name->bytes, module->bytes, module->length) != 0 ||
+            memcmp(name->bytes + module->length, prefix, sizeof prefix - 1) != 0)
+            continue;
+        uint32_t n = function->parameter_count, state = service->state_type;
+        MO_ASSERT(w->guarantee_count < GUARANTEES && n >= 2 &&
+                  function->parameters[0].type == state &&
+                  function->parameters[n - 1].type == state);
+        uint32_t tool = MO_NO_INDEX;
+        if (n != 2) {
+            for (tool = 0; tool < service->tool_count; tool++) {
+                const struct mo_bytecode_service_tool *t = &service->tools[tool];
+                if (n == t->argument_count + 3 &&
+                    same_types(function->parameters + 1, t->argument_types, t->argument_count) &&
+                    function->parameters[n - 2].type == t->result_type)
+                    break;
+            }
+            MO_ASSERT(tool < service->tool_count);
+        }
+        w->guarantees[w->guarantee_count++] = (struct guarantee){f, tool};
+    }
+}
+
+static uint32_t check_guarantees(const struct mo_recovery_observation *o, void *context) {
+    struct replies *w = context;
+    if (o->before == NULL || o->after == NULL)
+        return MO_NO_INDEX;
+    struct mo_heap *heap = mo_recovery_heap(w->recovery);
+    uint32_t state = w->service->state_type;
+    struct mo_cell before, after;
+    MO_ASSERT(mo_value_decode(heap, state, o->before->bytes, o->before->length, &before));
+    MO_ASSERT(mo_value_decode(heap, state, o->after->bytes, o->after->length, &after));
+    uint32_t failed = MO_NO_INDEX;
+    for (uint32_t g = 0; g < w->guarantee_count && failed == MO_NO_INDEX; g++) {
+        uint32_t tool = w->guarantees[g].tool;
+        if (tool != MO_NO_INDEX &&
+            (o->step->kind != MO_RECOVERY_SEND || o->step->tool != tool || o->reply == NULL))
+            continue;
+        const struct mo_bytecode_function *function =
+            &w->file->functions[w->guarantees[g].function];
+        uint32_t n = function->parameter_count;
+        struct mo_cell arguments[MO_LIMIT_BYTECODE_PARAMETERS];
+        arguments[0] = before;
+        arguments[n - 1] = after;
+        for (uint32_t a = 1; a + 2 < n; a++)
+            arguments[a] = o->step->arguments[a - 1];
+        if (n > 2)
+            arguments[n - 2] = o->reply->reply;
+        for (uint32_t a = 0; a < n; a++)
+            if (function->parameters[a].ownership == MO_PARAMETER_OWNED)
+                arguments[a] = mo_value_dup(heap, function->parameters[a].type, arguments[a]);
+        struct mo_cell held;
+        struct mo_defect defect;
+        MO_ASSERT(mo_call(mo_recovery_process(w->recovery), w->guarantees[g].function, arguments, n,
+                          &held, &defect) == MO_RETURNED);
+        if (!mo_cell_get_bool(held))
+            failed = w->guarantees[g].function;
+    }
+    mo_value_drop(heap, state, after);
+    mo_value_drop(heap, state, before);
+    return failed;
+}
