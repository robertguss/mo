module Main
total = twice(seed)
seed = 7
fn twice(value: T) : T where T: Number, T: Equal
examples
twice(seed) == total
end
promise "doubles its input"
result == value + value
allows value: 3, result: 6
forbids result: 5, value: 3
end
value + value
end
test "constants are initialized first"
assert total == 14
end
fn main() : Int
total
end
