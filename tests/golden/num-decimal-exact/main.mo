module Main

fn main(console: Console)
  console.print("#{0.1 + 0.2 == 0.3}")
  console.print("#{0.1 + 0.2}")
  console.print("#{1.00 / 3}")
  console.print("#{2.50 * 4}")
  console.print("#{15.5} #{3.0} #{0.001}")
  console.print("#{7.5 % 2}")
  console.print("#{-7.5 % 2}")
  console.print("#{19.99 * 3}")
  console.print("#{10.0 / 4}")
end
