{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*\\??",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:fn|struct|enum|service|actor|api|scope|test|promise|examples|for|while|case)\\b(?!.*\\bend\\s*(?:#.*)?$).*|(?:else\\s+)?if\\b(?![^#]*:).*|else\\s*(?:#.*)?|.*[\\[({]\\s*(?:#.*)?)$",
    "decreaseIndentPattern": "^\\s*(?:end\\b|else\\b|[\\])}])"
  },
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*(?:fn|struct|enum|service|actor|api|scope|test|promise|examples|for|while|case|if)\\b(?!.*\\bend\\s*(?:#.*)?$)",
      "end": "^\\s*end\\b"
    }
  }
}
